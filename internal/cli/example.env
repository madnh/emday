# emday secrets — a TEMPLATE for your service's EnvironmentFile.
#
# emday does NOT read this file. Nothing loads it automatically. It exists so
# you never have to remember which variable names your notifiers reference:
# fill in the values, then copy it to wherever your service unit points.
#
#   Unit generated by `emday install` (it already reads /etc/sysconfig/emday):
#       sudo install -m 0600 emday.env.example /etc/sysconfig/emday
#       sudo systemctl restart emday
#
#   Your own unit — point EnvironmentFile= at your copy:
#       [Service]
#       EnvironmentFile=/etc/emday/emday.env
#
#   Foreground / testing, to load it into your current shell:
#       set -a; . ./emday.env.example; set +a
#       emday test-notify my-telegram
#
# Full deployment guide: `emday docs deploy`.
#
# FORMAT: KEY=VALUE, one per line. No `export`, no shell expansion, no
# comments after a value — systemd parses this file itself, not through a
# shell. Quote only when the value contains spaces. Keep your copy mode 0600.
#
# Each name below must match the `token_env` / `secret_env` / `url_env` you
# wrote in emday.yaml — those fields hold the NAME of a variable, never the
# secret itself. After editing: `emday check-config`, then restart the
# service. `emday doctor` lists any referenced variable that is still unset.

# --- telegram -----------------------------------------------------------
# emday.yaml:  token_env: EMDAY_TG_TOKEN
EMDAY_TG_TOKEN=

# --- lark ---------------------------------------------------------------
# emday.yaml:  secret_env: EMDAY_LARK_SECRET   (only if the bot signs requests)
#EMDAY_LARK_SECRET=
# emday.yaml:  url_env: EMDAY_LARK_URL
#EMDAY_LARK_URL=

# --- webhook URLs are secrets too (the token lives in the path) ---------
# Uncomment the ones you reference with `url_env:` in emday.yaml.
# emday.yaml:  url_env: EMDAY_SLACK_URL
#EMDAY_SLACK_URL=
# emday.yaml:  url_env: EMDAY_DISCORD_URL
#EMDAY_DISCORD_URL=
# emday.yaml:  url_env: EMDAY_NTFY_URL
#EMDAY_NTFY_URL=
# emday.yaml:  url_env: EMDAY_WEBHOOK_URL
#EMDAY_WEBHOOK_URL=
